# ---------------------------------------------------------------------------
# AI Data Analyst — environment configuration
# Copy to .env and fill in your keys. Never commit .env.
# ---------------------------------------------------------------------------

# LLM provider: "openai" (Groq/OpenAI-compatible) or "none" (rule engine only)
LLM_PROVIDER=openai

# Groq is the primary LLM provider (spec requirement).
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model choice:
#   - llama-3.1-8b-instant   (default: high free-tier request cap, low latency)
#   - llama-3.3-70b-versatile (higher quality reasoning, lower free-tier cap)
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# Optional backup provider (auto-failover on rate limits). Free: Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# RAG / retrieval layer
ENABLE_RAG=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional API auth (if set, /api requires `Authorization: Bearer <key>`)
APP_API_KEY=

# App
DEBUG=false
