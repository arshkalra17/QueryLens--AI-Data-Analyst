# ---------------------------------------------------------------------------
# QueryLens — environment configuration
# Copy to .env and fill in your keys. Never commit .env.
# All values have defaults in config.py / docker-compose.yml, so an empty .env
# still runs the app on the built-in rule engine (no API key required).
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# "openai" : OpenAI-compatible API (Groq, OpenAI, Azure, LM Studio, ...)
# "none"   : force the built-in rule-based engine (no API key required)
LLM_PROVIDER=openai

# OpenAI-compatible endpoint (used directly when GROQ_API_KEY is not set).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model + generation settings (used when GROQ_API_KEY is not set).
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# --- Groq (primary LLM provider) --------------------------------------------
# Spec requirement. Get a free key at https://console.groq.com
# When set, it wins and points the OpenAI-compatible client at Groq.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- Gemini (optional failover provider) ------------------------------------
# Auto-failover on rate limits. Free key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Security ---------------------------------------------------------------
# If set, all /api endpoints require `Authorization: Bearer <APP_API_KEY>`.
# NOTE: the built-in UIs do not send this header — enable only for headless API use.
APP_API_KEY=

# --- App --------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# --- RAG / retrieval --------------------------------------------------------
ENABLE_RAG=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_K_TABLE=3
RAG_K_HISTORY=4
MAX_CHUNK_CHARS=800

# --- Document RAG -------------------------------------------------------------
# Business docs (PDF/MD/TXT/DOCX) answered with citations and used to ground SQL.
ENABLE_DOCS=true
DOC_TOP_K=5
# dense | bm25 | hybrid | hybrid_rerank
DOC_RETRIEVAL_MODE=hybrid_rerank
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# cross-encoder score below which the docs are treated as not covering a question
DOC_MIN_RERANK_SCORE=-6.0

# --- Uploads / execution ----------------------------------------------------
MAX_UPLOAD_MB=50
MAX_DATASETS=25
MAX_SQL_CHARS=4000
SQL_TIMEOUT_SECONDS=10.0
MAX_SQL_ROWS=500
ALLOW_PANDAS_EXEC=true

# --- Caching / conversation memory ------------------------------------------
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
CONVERSATION_WINDOW=8
# "sqlite" persists chats to data/sessions/sessions.db (survives restarts,
# shared across API workers); "memory" keeps them in-process only.
SESSION_STORE=sqlite
MAX_SESSIONS=1000

# --- Agent ------------------------------------------------------------------
# How many times the LLM may repair a failed SQL query using the DuckDB error.
SQL_REPAIR_ATTEMPTS=2
